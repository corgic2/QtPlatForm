# qtbuild.env — 可选的环境变量 / 路径定制文件（模板）
#
# 用法：
#   1. 复制到仓库根目录并重命名：cp scripts/qtbuild.env.example qtbuild.env
#   2. 按需取消注释、修改路径
#   3. 之后直接跑 scripts/build-qt*.sh 或 scripts/qt-cmake-build.sh 即生效
#
# scripts/common.sh 在每次构建前会自动 source 本文件（若存在）；
# 也可以不建文件，直接在 shell 里 export 同名变量，效果一样。
# 不创建本文件时，所有路径默认指向仓库内部（见各变量右侧注释的默认值），
# 克隆后无需任何配置即可按 README 第 3 节开始。
#
# 所有变量都是可选的，只改你需要的那几项即可。

# ---- Qt 5.15.2 源码目录 ----
# 默认 <repo>/Qt/5.15.2/Src（gitignored，需按 README 第 3 节自行 clone）
# 想复用别处已 clone 的源码时设置：
# export QT_SRC=/home/user/workspace/qt-src-5.15.2

# ---- 构建与产物根目录 ----
# 默认 <repo>/Qt/5.15.2/build，各目标 install/ 子目录会被 git 跟踪留档。
# 磁盘不够 / 不想让产物进 git 时，可指到仓库外：
# export QT_BUILD=/data/qt-build

# ---- 原生 x86_64 install（兼任交叉编译的 host 工具）----
# 默认 <QT_BUILD>/x86_64-linux-gnu/install；一般无需设置。
# export QT_HOST=/data/qt-build/x86_64-linux-gnu/install

# ---- 交叉工具链目录 ----
# 默认自动使用仓库 tools/ 下对应架构的工具链（arm64: gcc 14.2；arm32: gcc 14.2，
# 或通过 TARGET_SUFFIX/_10_3_1 目录用 gcc 10.3）。想用自装工具链时设置：
# export VENDORED_TC=/opt/arm-gnu-toolchain-14.2

# ---- 交叉编译器前缀 ----
# 默认取工具链自带前缀（arm64: aarch64-none-linux-gnu-；arm32: arm-none-linux-gnueabihf-），
# 找不到时回退到发行版前缀。用发行版工具链时显式设置：
# export CROSS_PREFIX=aarch64-linux-gnu-

# ---- 板级 sysroot ----
# 目标板是标准 Debian/Ubuntu arm64 用户态：留空（工具链自带匹配 libc）。
# 目标板是厂商定制系统（BSP / Yocto / Buildroot）：指向板子 sysroot，应用侧
# CMake 构建时也要在环境里设同一个 SYSROOT（toolchain/*.cmake 会读取）。
# export SYSROOT=/opt/board-sysroot

# ---- 构建目录后缀 ----
# 在同一架构下用不同工具链各编一份时，用后缀区分产物目录，
# 例如 _10_3_1 -> 产物装到 <QT_BUILD>/aarch64-linux-gnu_10_3_1/install。
# export TARGET_SUFFIX=_10_3_1
